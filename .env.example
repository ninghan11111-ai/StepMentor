# Optional OpenAI-compatible MiniCPM-o 4.5 service.
MINICPM_BASE_URL=http://127.0.0.1:8000
MINICPM_API_KEY=
MINICPM_MODEL=MiniCPM-o-4_5

# Official Comni gateway used for streaming full-duplex voice.
MINICPM_REALTIME_URL=http://127.0.0.1:8040
MINICPM_REALTIME_LABEL=Local MiniCPM-o 4.5

# Cloud example. Prefer an SSH tunnel while developing:
# ssh -N -L 8040:127.0.0.1:<cloud-gateway-port> <user>@<server-ip>
# MINICPM_REALTIME_URL=http://127.0.0.1:8040
# MINICPM_REALTIME_LABEL=Cloud Ascend MiniCPM-o 4.5
